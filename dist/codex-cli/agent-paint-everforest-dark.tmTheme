<plist version="1.0">
<dict>
  <key>name</key>
  <string>Agent Paint · Everforest Dark</string>
  <key>author</key>
  <string>Agent Paint contributors</string>
  <key>settings</key>
  <array>
    <dict>
      <key>settings</key>
      <dict>
        <key>background</key>
        <string>#1e2326</string>
        <key>foreground</key>
        <string>#d3c6aa</string>
