<plist version="1.0">
<dict>
  <key>name</key>
  <string>Agent Paint · Night Owl</string>
  <key>author</key>
  <string>Agent Paint contributors</string>
  <key>settings</key>
  <array>
    <dict>
      <key>settings</key>
      <dict>
        <key>background</key>
        <string>#011627</string>
